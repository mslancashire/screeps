        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "checkJs": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}